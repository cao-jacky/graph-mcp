# Copy to .env and fill in. .env is gitignored — keep the password out of
# version control and out of any notes directory that syncs to a git remote.

# --- Corpus ---------------------------------------------------------------
# Falls back to KNOWLEDGE_MCP_ROOT if that is already exported, so the graph
# indexes exactly the corpus knowledge-mcp serves.
GRAPH_MCP_KB_ROOT=/path/to/your/Knowledge

# --- Neo4j ----------------------------------------------------------------
# Use 127.0.0.1 when graph-mcp runs on the same host as Neo4j; otherwise the
# private address Neo4j is bound to (see deploy/docker-compose.neo4j.yml).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Embeddings -----------------------------------------------------------
# Any OpenAI-compatible /v1/embeddings endpoint: LM Studio, Ollama, vLLM,
# text-embeddings-inference, or a hosted provider.
GRAPH_MCP_EMBED_BASE_URL=http://127.0.0.1:1234/v1
GRAPH_MCP_EMBED_MODEL=text-embedding-qwen3-embedding-8b
# Must match the model's output width AND the vector index. Qwen3-Embedding-8B
# is 4096, which is also Neo4j's per-vector ceiling.
GRAPH_MCP_EMBED_DIM=4096
GRAPH_MCP_EMBED_BATCH=16

# --- Stage 3 extraction LLM ----------------------------------------------
# A local model keeps the backfill free and keeps note content on your machine.
GRAPH_MCP_LLM_BASE_URL=http://127.0.0.1:1234/v1
GRAPH_MCP_LLM_MODEL=qwen3.5-122b-a10b
GRAPH_MCP_LLM_API_KEY=lm-studio

# --- Stage gate -----------------------------------------------------------
# Leave unset until Stage 3 has run and been validated; the relationship
# tools stay unregistered while it is off.
# GRAPH_MCP_SEMANTIC_TOOLS=1
